{
  "name": "awesome-proton",
  "version": "1.0.0",
  "description": "List of games tested with Proton (Tool for Steam Client on Linux)",
  "license": "CC0-1.0",
  "author": {
    "name": "Tiago Danin",
    "url": "https://github.com/TiagoDanin"
  },
  "homepage": "https://github.com/TiagoDanin/Awesome-Proton#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TiagoDanin/Awesome-Proton.git"
  },
  "bugs": {
    "url": "https://github.com/TiagoDanin/Awesome-Proton/issues"
  },
  "keywords": [
    "proton",
    "steam",
    "linux",
    "gaming",
    "awesome",
    "awesome-list",
    "wine",
    "compatibility",
    "steam-play"
  ],
  "type": "commonjs",
  "main": "build.js",
  "files": [
    "build.js",
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test",
    "ci": "npm run format:check && npm run lint && npm run test && npm run build",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "load-json-file": "^7.0.1",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2"
  }
}
