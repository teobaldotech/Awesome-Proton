#!/usr/bin/env bash

###############################################################################
# Strict Mode
###############################################################################

set -Eeuo pipefail

###############################################################################
# Error Handling
###############################################################################

_err() {
  local lineno="$1"
  local exit_code="$2"
  local command="$3"

  printf \
    'ERROR [line=%s] [exit=%s]: %s\n' \
    "$lineno" \
    "$exit_code" \
    "$command" >&2
}

_stacktrace() {
  local i

  printf 'Stack trace:\n' >&2

  for ((i=1; i<${#FUNCNAME[@]}; i++)); do
    printf \
      '  at %s() [%s:%s]\n' \
      "${FUNCNAME[$i]}" \
      "${BASH_SOURCE[$i]}" \
      "${BASH_LINENO[$((i-1))]}" >&2
  done
}

error_handler() {
  local exit_code=$?
  local line_no="$1"
  local command="$2"

  _err "$line_no" "$exit_code" "$command"
  _stacktrace
}

###############################################################################
# Cleanup
###############################################################################

_cleanup_ran=0

cleanup() {
  (( _cleanup_ran )) && return

  _cleanup_ran=1

  printf 'Cleaning up...\n' >&2

  if [[ -n "${TEST_MARKER_FILE:-}" ]]; then
    touch -- "$TEST_MARKER_FILE"
  fi

  if [[ -n "${TMP_DIR:-}" && -d "${TMP_DIR}" ]]; then
    rm -rf -- "$TMP_DIR"
  fi

  while popd >/dev/null 2>&1; do
    :
  done
}

###############################################################################
# Signal Handlers
###############################################################################

on_interrupt() {
  local signal="$1"

  printf '\nReceived %s. Aborting...\n' "$signal" >&2

  cleanup

  case "$signal" in
    SIGINT)
      exit 130
      ;;
    SIGTERM)
      exit 143
      ;;
    *)
      exit 1
      ;;
  esac
}

trap 'error_handler "$LINENO" "$BASH_COMMAND"' ERR
trap 'on_interrupt SIGINT' INT
trap 'on_interrupt SIGTERM' TERM
trap cleanup EXIT

###############################################################################
# Utility Functions
###############################################################################

resolve_path() {
  local path="$1"

  if command -v realpath >/dev/null 2>&1; then
    realpath "$path"
    return
  fi

  if command -v readlink >/dev/null 2>&1; then
    local resolved

    if resolved="$(readlink -f "$path" 2>/dev/null)"; then
      printf '%s\n' "$resolved"
      return
    fi
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$path" <<'PY'
import os
import sys
print(os.path.realpath(sys.argv[1]))
PY
    return
  fi

  printf 'Unable to resolve path: %s\n' "$path" >&2
  return 1
}

require_cmd() {
  local cmd="$1"

  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'Required command not found: %s\n' "$cmd" >&2
    exit 2
  }
}

require_file() {
  local file="$1"

  [[ -f "$file" ]] || {
    printf 'Required file not found: %s\n' "$file" >&2
    exit 3
  }
}

require_executable() {
  local file="$1"

  [[ -x "$file" ]] || {
    printf 'File not executable: %s\n' "$file" >&2
    exit 3
  }
}

require_directory() {
  local dir="$1"

  [[ -d "$dir" ]] || {
    printf 'Directory not found: %s\n' "$dir" >&2
    exit 4
  }
}

require_writable_parent() {
  local path="$1"
  local parent

  parent="$(dirname "$path")"

  [[ -d "$parent" ]] || {
    printf 'Parent directory does not exist: %s\n' "$parent" >&2
    exit 7
  }

  [[ -w "$parent" ]] || {
    printf 'Parent directory not writable: %s\n' "$parent" >&2
    exit 7
  }
}

###############################################################################
# Repository Paths
###############################################################################

readonly REPO_PATH="$(dirname "$(resolve_path "$0")")"

readonly PROFILE_PATH="$REPO_PATH/engine/src/out/host_profile"
readonly GN="$REPO_PATH/engine/src/flutter/tools/gn"
readonly LICENSE_CPP="$PROFILE_PATH/licenses_cpp"

readonly WORKING_DIR="$REPO_PATH/engine/src"

readonly LICENSES_PATH="$REPO_PATH/engine/src/flutter/sky/packages/sky_engine/LICENSE"

readonly DATA_PATH="$REPO_PATH/engine/src/flutter/tools/licenses_cpp/data"

printf 'Repository path: %s\n' "$REPO_PATH"

###############################################################################
# Temporary Workspace
###############################################################################

TMP_DIR="$(mktemp -d)"
readonly TMP_DIR

printf 'Temporary directory: %s\n' "$TMP_DIR"

###############################################################################
# Dependency Validation
###############################################################################

require_cmd python3
require_cmd gclient
require_cmd ninja

###############################################################################
# Filesystem Validation
###############################################################################

require_executable "$GN"
require_directory "$WORKING_DIR"

###############################################################################
# Main
###############################################################################

main() {
  printf 'Starting build steps...\n'

  pushd "$WORKING_DIR" >/dev/null

  printf 'Running gclient sync...\n'
  gclient sync

  printf 'Generating GN files...\n'
  "$GN" --unoptimized

  printf 'Building target...\n'
  ninja -C "$PROFILE_PATH" licenses_cpp

  printf 'Checking generated binary...\n'
  require_file "$LICENSE_CPP"

  printf 'Running licenses generation...\n'
  "$LICENSE_CPP"

  printf 'Done.\n'
}

main "$@"
